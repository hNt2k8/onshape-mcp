# onshape-mcp credentials — copy to ~/.config/onshape-mcp/.env (chmod 600).
# `uv run --no-editable onshape-mcp setup` creates that file for you.
# NEVER put a real .env in the project folder or commit it.
# Keys come from https://dev-portal.onshape.com/keys
ONSHAPE_ACCESS_KEY=your-access-key-here
ONSHAPE_SECRET_KEY=your-secret-key-here
# Optional overrides (defaults shown):
# ONSHAPE_BASE_URL=https://cad.onshape.com
# ONSHAPE_API_VERSION=v10
